# Copiar como .env y completar. NUNCA subir el .env al repositorio.

# --- Frontend (expuestas al navegador, es correcto que lo sean) ---
VITE_SUPABASE_URL=https://TU_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key

# --- Solo Edge Functions (variables del proyecto en Supabase) ---
# La service role key NUNCA lleva prefijo VITE_ ni llega al navegador.
SUPABASE_SERVICE_ROLE_KEY=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
